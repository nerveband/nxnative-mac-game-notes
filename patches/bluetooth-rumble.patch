+@interface TestStadia : DmStadiaRumbleChannel
+@property NSMutableArray<NSArray<NSNumber *> *> *packets;
+@end
+@implementation TestStadia
+- (void)sendLow:(uint16_t)low high:(uint16_t)high { [self.packets addObject:@[@(low), @(high)]]; }
+@end
 static void drain(void) { dispatch_sync(queue, ^{}); dispatch_sync(queue, ^{}); }
 static void expire_retries(void) {
     dispatch_sync(queue, ^{ for (DmRumbleChannel *c in channels[0]) c.retryAfter = 0; });
@@ -175,6 +181,30 @@ int main(void) { @autoreleasepool {
     unsupported.haptics.supportedLocalities = [NSSet set];
     dm_haptics_apple_controller(0, (id)unsupported); drain();
     assert(!(dm_haptics_available() & 1) && unsupported.haptics.attempts == 0);
+    TestStadia *stadia = [TestStadia new]; stadia.packets = [NSMutableArray new];
+    dispatch_sync(queue, ^{ channels[0] = [NSMutableArray arrayWithObject:stadia]; });
+    dm_haptics_route(0, 1); drain(); [stadia.packets removeAllObjects];
+    // Emulate a blocked Bluetooth output queue while hundreds of game updates
+    // arrive, ending with stop. Only that current stop may reach the hardware.
+    dispatch_semaphore_t gate = dispatch_semaphore_create(0);
+    dispatch_async(queue, ^{ dispatch_semaphore_wait(gate, DISPATCH_TIME_FOREVER); });
+    for (int i = 0; i < 400; i++) {
+        dm_vibration_update u = {0, 0, {(i & 1) ? 0.8f : 0.4f, 160, 0, 320}};
+        dm_haptics_send(&u, 1);
+    }
+    dm_vibration_update stop = {0, 0, {0, 160, 0, 320}};
+    dm_haptics_send(&stop, 1);
+    dispatch_semaphore_signal(gate); drain();
+    assert(stadia.packets.count == 1);
+    assert(stadia.packets[0][0].intValue == 0 && stadia.packets[0][1].intValue == 0);
+    dm_vibration_update bands[] = {{0, 0, {0.4f, 160, 0.2f, 320}}, {0, 1, {0.4f, 160, 0.2f, 320}}};
+    dm_haptics_send(bands, 2); drain();
+    assert(abs(stadia.packets.lastObject[0].intValue - 26214) <= 1);
+    assert(abs(stadia.packets.lastObject[1].intValue - 13107) <= 1);
+    dm_haptics_suspend(DM_HAPTICS_INACTIVE, YES); drain();
+    assert(stadia.packets.lastObject[0].intValue == 0 && stadia.packets.lastObject[1].intValue == 0);
+    dm_haptics_suspend(DM_HAPTICS_INACTIVE, NO); drain();
+    puts("Stadia: queued effects coalesced to the latest stop, separate motor bands and focus-loss stop passed");
     dm_haptics_apple_shutdown();
     puts("Apple haptics: channels, pulses, idle release, startup handlers, engine replacement, backoff and stale callbacks passed");
 } }
