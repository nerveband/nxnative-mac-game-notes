+#if !TARGET_OS_IPHONE
+// The tested Stadia BLE device exposed no Core Haptics localities. Its HID output report 5
+// contains two little-endian 16-bit motor strengths, as documented by SDL.
+@interface DmStadiaRumbleChannel : DmRumbleChannel
+@property(nonatomic, assign) IOHIDDeviceRef device;
+- (void)applyState:(dm_haptic_state)state;
+- (void)sendLow:(uint16_t)low high:(uint16_t)high;
+@end
+@implementation DmStadiaRumbleChannel
+- (void)sendLow:(uint16_t)low high:(uint16_t)high {
+    uint8_t packet[] = {5, low & 255, low >> 8, high & 255, high >> 8};
+    IOReturn result = IOHIDDeviceSetReport(self.device, kIOHIDReportTypeOutput, 5, packet, sizeof(packet));
+    if (result != kIOReturnSuccess && ++errors <= 8)
+        fprintf(stderr, "haptics: Stadia HID write failed: %#x\n", result);
+}
+- (void)applyState:(dm_haptic_state)s {
+    // Average the two Joy-Con motors' band power into a conventional low/high
+    // motor pair. Do not sum both bands and drive both motors at that strength.
+    float lo = 0, hi = 0;
+    for (int i = 0; i < 2; i++) {
+        lo += s.motor[i].amplitude_low * s.motor[i].amplitude_low;
+        hi += s.motor[i].amplitude_high * s.motor[i].amplitude_high;
+    }
+    [self sendLow:(uint16_t)lrintf(fminf(1, sqrtf(lo / 2) * gain) * 65535)
+             high:(uint16_t)lrintf(fminf(1, sqrtf(hi / 2) * gain) * 65535)];
+}
+- (void)stop { [self sendLow:0 high:0]; }
+- (void)dealloc {
+    if (_device) {
+        [self stop]; IOHIDDeviceClose(_device, 0); CFRelease(_device);
+    }
+}
+@end
+// Microsoft's Bluetooth Xbox report uses 0..100 strengths and separate
+// trigger motors. This fallback leaves the triggers off.
+@interface DmXboxRumbleChannel : DmStadiaRumbleChannel
+@end
+@implementation DmXboxRumbleChannel
+- (void)sendLow:(uint16_t)low high:(uint16_t)high {
+    uint8_t packet[] = {3, 15, 0, 0, low / 655, high / 655, 255, 0, 235};
+    IOReturn result = IOHIDDeviceSetReport(self.device, kIOHIDReportTypeOutput, 3, packet, sizeof(packet));
+    if (result != kIOReturnSuccess && ++errors <= 8)
+        fprintf(stderr, "haptics: Xbox HID write failed: %#x\n", result);
+}
+@end
+static void hid_controller(int p, GCController *controller) {
+    IOHIDManagerRef manager = IOHIDManagerCreate(kCFAllocatorDefault, 0);
+    BOOL xbox = [controller.vendorName containsString:@"Xbox"];
+    NSDictionary *match = xbox ? @{@kIOHIDVendorIDKey: @0x045e} : @{@kIOHIDVendorIDKey: @0x18d1, @kIOHIDProductIDKey: @0x9400};
+    IOHIDManagerSetDeviceMatching(manager, (__bridge CFDictionaryRef)match);
+    CFSetRef devices = IOHIDManagerCopyDevices(manager);
+    for (id obj in (__bridge NSSet *)devices) {
+        IOHIDDeviceRef device = (__bridge IOHIDDeviceRef)obj;
+        NSString *name = (__bridge NSString *)IOHIDDeviceGetProperty(device, CFSTR(kIOHIDProductKey));
+        if (![name isEqualToString:controller.vendorName]) continue;
+        NSString *transport = (__bridge NSString *)IOHIDDeviceGetProperty(device, CFSTR(kIOHIDTransportKey));
+        if (xbox && ![transport hasPrefix:@"Bluetooth"]) continue;
+        BOOL used = NO;
+        for (int slot = 0; slot < DM_PLAYERS; slot++) for (DmRumbleChannel *c in channels[slot])
+            if ([c isKindOfClass:DmStadiaRumbleChannel.class] && ((DmStadiaRumbleChannel *)c).device == device) used = YES;
+        if (used || IOHIDDeviceOpen(device, 0) != kIOReturnSuccess) continue;
+        uint8_t stopStadia[] = {5, 0, 0, 0, 0};
+        uint8_t stopXbox[] = {3, 15, 0, 0, 0, 0, 255, 0, 235};
+        uint8_t *stop = xbox ? stopXbox : stopStadia;
+        size_t length = xbox ? sizeof(stopXbox) : sizeof(stopStadia);
+        if (IOHIDDeviceSetReport(device, kIOHIDReportTypeOutput, stop[0], stop, length) == kIOReturnSuccess) {
+            DmStadiaRumbleChannel *c = xbox ? [DmXboxRumbleChannel new] : [DmStadiaRumbleChannel new];
+            c.device = (IOHIDDeviceRef)CFRetain(device); c.player = p;
+            [channels[p] addObject:c];
+            fprintf(stderr, "haptics: player %d %s HID rumble enabled\n", p + 1, xbox ? "Xbox Bluetooth" : "Stadia");
+            break;
+        }
+        IOHIDDeviceClose(device, 0);
+    }
+    if (devices) CFRelease(devices);
+    CFRelease(manager);
+}
+#endif
+
+// Measured Stadia BLE writes took about 63 ms each.
+// Keep at most one waiting snapshot per player, never replay old effects.
+static pthread_mutex_t pendingLock = PTHREAD_MUTEX_INITIALIZER;
+static dm_haptic_state pendingState[DM_PLAYERS];
+static BOOL pendingOutput[DM_PLAYERS];
 static void apply(dm_haptic_state s) {
+    int p = s.player;
+    pthread_mutex_lock(&pendingLock);
+    pendingState[p] = s;
+    BOOL queued = pendingOutput[p]; pendingOutput[p] = YES;
+    pthread_mutex_unlock(&pendingLock);
+    if (queued) return;
     dispatch_async(queue, ^{ @autoreleasepool {
-        if (s.epoch != dm_haptics_epoch(s.player)) return;
-        NSArray<DmRumbleChannel *> *out = channels[s.player];
+        pthread_mutex_lock(&pendingLock);
+        dm_haptic_state current = pendingState[p]; pendingOutput[p] = NO;
+        pthread_mutex_unlock(&pendingLock);
+        if (current.epoch != dm_haptics_epoch(p)) return;
+        NSArray<DmRumbleChannel *> *out = channels[p];
         for (NSUInteger i = 0; i < out.count; i++) {
-            if (s.epoch != dm_haptics_epoch(s.player)) break;   // a failed channel may replace this route
-            dm_haptic_level level = out.count == 2 ? dm_haptics_level(&s.motor[i], 1, gain) : dm_haptics_level(s.motor, 2, gain);
+            if (current.epoch != dm_haptics_epoch(p)) break;
+#if !TARGET_OS_IPHONE
+            if ([out[i] isKindOfClass:DmStadiaRumbleChannel.class]) {
+                [(DmStadiaRumbleChannel *)out[i] applyState:current]; continue;
+            }
+#endif
+            dm_haptic_level level = out.count == 2 ? dm_haptics_level(&current.motor[i], 1, gain) : dm_haptics_level(current.motor, 2, gain);
             [out[i] apply:level];
         }
     } });
@@ -152,6 +251,14 @@ static void default_controller(int p, GCDeviceHaptics *h, NSTimeInterval retryAf
 static void configure(int p, GCController *controller) {
     for (DmRumbleChannel *c in channels[p]) [c stop];
     channels[p] = [NSMutableArray new];
+#if !TARGET_OS_IPHONE
+    // The Xbox Core Haptics helper can accept the engine but fail every pattern
+    // with NSCocoaErrorDomain 4097. Prefer its verified Bluetooth HID output.
+    if ([controller.vendorName containsString:@"Xbox"]) {
+        hid_controller(p, controller);
+        if (channels[p].count) { dm_haptics_route(p, 1); return; }
+    }
+#endif
     if (controller) {
         GCDeviceHaptics *h = controller.haptics;
         NSSet *localities = h.supportedLocalities;
@@ -179,6 +286,10 @@ static void configure(int p, GCController *controller) {
         // Do not initialize the phone's engine before the game's audio session is active.
         add_engine(p, @"phone", ^CHHapticEngine *(NSError **e) { return [[CHHapticEngine alloc] initWithAudioSession:AVAudioSession.sharedInstance error:e]; });
     }
+#endif
+#if !TARGET_OS_IPHONE
+    if (controller && !channels[p].count && [controller.vendorName hasPrefix:@"Stadia"])
+        hid_controller(p, controller);
 #endif
     dm_haptics_route(p, channels[p].count != 0);
 }
