     atomic_store(&g_sig,0); return failed;
 }
+static int coalesced_releases(void) {
+    char out[64], ev[64]; uint8_t prm[16], pcm[16] = {0}, played[16]; gbuf b[2] = {0};
+    h_au_InitParam(prm); h_au_Open(out, ev, NULL, prm);
+    aout *a = ao(out); atomic_store(&a->state, STATE_STARTED); atomic_store(&g_sig, 0);
+    for (int i = 0; i < 2; i++) { h_au_SetBuf(&b[i], pcm + i * 8, 8, 8); h_au_Append(out, &b[i]); }
+    pull(a, played, sizeof played);
+    for (int i = 0; i < 100 && atomic_load(&g_sig) < 1; i++) usleep(1000);
+    int before = atomic_load(&g_sig), failed = before < 1;
+    pull(a, played, 1); // A later callback must still report unread released buffers, without a new release.
+    for (int i = 0; i < 100 && atomic_load(&g_sig) == before; i++) usleep(1000);
+    failed |= atomic_load(&g_sig) <= before;
+    before = atomic_load(&g_sig); failed |= h_au_Released(out) != &b[0];
+    for (int i = 0; i < 100 && atomic_load(&g_sig) == before; i++) usleep(1000);
+    failed |= atomic_load(&g_sig) <= before || h_au_Released(out) != &b[1];
+    h_au_Close(out);
+    printf("Coalesced releases preserve the remaining buffer's event: %s\n", failed ? "FAIL" : "PASS");
+    return failed;
+}
